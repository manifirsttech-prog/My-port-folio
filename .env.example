# ─── Firebase Project Configuration ──────────────────────────────────────────
# Copy this file to .env and fill in your values from:
# Firebase Console → Project Settings → Your Apps → Web App → SDK setup & config

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ─── Cloudinary Configuration ─────────────────────────────────────────────────
# Get these values from: Cloudinary Dashboard → Account Settings
# https://console.cloudinary.com/

VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_API_KEY=your_api_key_here
VITE_CLOUDINARY_API_SECRET=your_api_secret_here

# ─── Notes ────────────────────────────────────────────────────────────────────
# 1. Never commit .env to version control (it is already in .gitignore).
# 2. In Firebase Console, enable:
#      Authentication → Sign-in providers → Email/Password + Google
#      Firestore Database → Create database (start in test mode, then secure)
#      Storage → Get started
